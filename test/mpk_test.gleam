pub fn to_safe_identifier_test() -> Nil {
  { xml.to_safe_identifier("Progress Bar") == "ProgressBar" }
  |> should.be_true
  { xml.to_safe_identifier("Data-Grid") == "DataGrid" }
  |> should.be_true
  { xml.to_safe_identifier("Normal") == "Normal" }
  |> should.be_true
  Nil
}

